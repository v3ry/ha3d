# Configuration Ha3D — copier ce fichier vers .env puis remplir
# (le serveur lit ./.env puis ~/.env ; les variables d'environnement
#  réelles ont priorité sur le fichier .env)

# --- Home Assistant (obligatoire) ---
# URL de ton instance HA
HASS_URL=http://192.168.1.50:8123
# Token longue durée (Profil > Jetons d'accès longue durée)
HA_TOKEN=

# --- Réseau du serveur Ha3D (optionnel) ---
# Interface d'écoute : 127.0.0.1 = local uniquement (défaut, sûr),
# 0.0.0.0 ou IP LAN pour accéder depuis d'autres appareils
# MAISON3D_HOST=127.0.0.1
# MAISON3D_PORT=9125

# --- Géolocalisation (optionnel) ---
# Priorité sur la config HA (latitude/longitude). Sans ces valeurs,
# Ha3D utilise celles exposées par Home Assistant (/api/config).
# HA3D_LAT=45.83
# HA3D_LON=4.62
