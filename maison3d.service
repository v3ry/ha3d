[Unit]
Description=Maison 3D - visualiseur 3D des capteurs Home Assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes
WorkingDirectory=/home/hermes/ha3d
ExecStart=/usr/bin/python3 /home/hermes/ha3d/ha3d_server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
